# Laravel FSM Docker Environment Configuration

# Git Repository Configuration
GIT_REPO=https://github.com/Krisaley/LaravelFieldServiceManagement.git
GIT_BRANCH=phase1-core
GIT_TOKEN=  # Add your GitHub personal access token if repo is private

# Application
APP_NAME="Laravel FSM Phase 1"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080

# Database
DB_DATABASE=laravel_fsm
DB_USERNAME=sail
DB_PASSWORD=password
DB_ROOT_PASSWORD=rootpassword
DB_PORT=3306

# Redis
REDIS_PORT=6379

# Meilisearch
MEILISEARCH_PORT=7700
MEILI_MASTER_KEY=masterKey
MEILI_ENV=development
MEILI_NO_ANALYTICS=true

# GitOps Settings
GITOPS_ENABLED=true
GITOPS_INTERVAL=300
GITOPS_AUTO_MIGRATE=true
GITOPS_AUTO_INSTALL=true
GITOPS_AUTO_SEED=false
SEED_DEMO_DATA=false

# Vite
VITE_PORT=5173
